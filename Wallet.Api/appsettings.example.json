{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InternalSecurity": {
    "ServiceKey": "<REPLACE_WITH_INTERNAL_SERVICE_SECRET>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require&channel_binding=require"
  },
  "Stripe": {
    "SecretKey": "<SET_VIA_ENVIRONMENT>",
    "WebhookSecret": "<SET_VIA_ENVIRONMENT>",
    "SuccessUrl": "https://example.test/payments/success",
    "CancelUrl": "https://example.test/payments/cancel"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  }
}
