# =============================================================================
# ENVIRONMENT VARIABLES FOR WALLET SERVICE (.env.example)
# =============================================================================
# Hỗ trợ 2 hồ sơ môi trường:
#   1. Local DB (PostgreSQL Cục bộ port 5440): cp .env.local.example .env
#   2. Server DB (PostgreSQL Neon Cloud):      cp .env.server.example .env
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008

# Database Connection (Mặc định Local DB)
CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres
WALLET_CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres
WALLET_DB_PORT=5440
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
