# =============================================================================
# ENVIRONMENT VARIABLES FOR WALLET SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008
WALLET_DB_PORT=5440

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-flat-frost-a1sets6g-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=wallet_db;Username=neondb_owner;Password=<REPLACE_WITH_WALLET_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
WALLET_CONNECTION_STRING=Host=ep-flat-frost-a1sets6g-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=wallet_db;Username=neondb_owner;Password=<REPLACE_WITH_WALLET_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
