# Environment variables for Wallet Service
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8008

# Database (Neon PostgreSQL)
NEON_CONNECTION_STRING=Host=YOUR_NEON_HOST;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require

# Local database setting for running the API outside Docker
ConnectionStrings__DefaultConnection=Host=localhost;Port=5439;Database=wallet_db;Username=postgres;Password=postgres

# RabbitMQ
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__User=guest
RabbitMq__Password=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
