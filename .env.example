# =============================================================================
# NEXUS WALLET SERVICE - ENVIRONMENT (.env.example)
# =============================================================================
# Local development uses PostgreSQL from docker-compose.db.yml.

ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008

# Optional: use a remote PostgreSQL database instead of the local Compose database.
# WALLET_CONNECTION_STRING=postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require

# Stripe test mode: use an sk_test_ key, a whsec_ signing secret, and HTTPS URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=<REPLACE_WITH_INTERNAL_SERVICE_SECRET>

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
