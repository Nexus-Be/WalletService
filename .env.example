# =============================================================================
# NEXUS WALLET SERVICE - ENVIRONMENT (.env.example)
# =============================================================================
# Local development uses PostgreSQL from docker-compose.db.yml.

ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008

# Optional: use a remote PostgreSQL database instead of the local Compose database.
# WALLET_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require
# WALLET_CONNECTION_STRING=<OPTIONAL_OVERRIDE>

# VNPay
VNPAY_TMN_CODE=<REPLACE_WITH_VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<REPLACE_WITH_VNPAY_HASH_SECRET>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://localhost:8080/api/v1/wallets/vnpay/return
VNPAY_VERSION=2.1.0

# Stripe test mode: use an sk_test_ key, a whsec_ signing secret, and HTTPS URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=<REPLACE_WITH_INTERNAL_SERVICE_SECRET>

# Outbound notifications (NotificationService)
NOTIFICATION_SERVICE_URL=http://localhost:8007
NOTIFICATION_SERVICE_KEY=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
