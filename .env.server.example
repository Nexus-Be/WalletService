# =============================================================================
# NEXUS WALLET SERVICE - SERVER ENVIRONMENT CONFIGURATION (.env.server.example)
# =============================================================================
# Áp dụng: cp .env.server.example .env
# KHÔNG commit file .env. Mọi giá trị <REPLACE_...> phải được thay bằng secret thật
# lấy từ secret manager; không bao giờ ghi secret thật vào file example.

ASPNETCORE_ENVIRONMENT=Production
WALLET_SERVICE_PORT=8008

# Database (Neon Cloud PostgreSQL)
WALLET_CONNECTION_STRING=postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require&channel_binding=disable

# VNPay
VNPAY_TMN_CODE=<REPLACE_WITH_VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<REPLACE_WITH_VNPAY_HASH_SECRET>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://localhost:8080/api/v1/wallets/vnpay/return
VNPAY_VERSION=2.1.0

# Internal service-to-service authentication (generate: openssl rand -base64 32)
INTERNAL_SERVICE_SECRET=<REPLACE_WITH_INTERNAL_SERVICE_SECRET>

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
