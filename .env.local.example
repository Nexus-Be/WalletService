# =============================================================================
# WALLET SERVICE - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Áp dụng: cp .env.local.example .env
ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008

# Database Connection (Local Docker PostgreSQL: Port 5440)
CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres
WALLET_CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres
WALLET_DB_PORT=5440
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
