# =============================================================================
# NEXUS WALLET SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
WALLET_SERVICE_PORT=8008

# Local PostgreSQL. Set WALLET_CONNECTION_STRING to a Neon URL to use Neon instead.
WALLET_CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres

# Stripe test mode: use an sk_test_ key, a whsec_ signing secret, and HTTPS URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=<REPLACE_WITH_INTERNAL_SERVICE_SECRET>

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
